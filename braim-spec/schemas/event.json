{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baim.dev/schemas/event.json",
  "title": "BRAIM BuildBus Event",
  "description": "Событие шины BuildBus (CloudEvents-style envelope)",
  "type": "object",
  "required": ["id", "type", "source", "subject", "time", "data"],
  "properties": {
    "id": {"type": "string", "pattern": "^evt_[0-9a-zA-Z]{20,}$"},
    "type": {"type": "string", "pattern": "^org\\.braim\\.[a-z]+\\.[a-z-]+\\.v\\d+$"},
    "source": {"type": "string", "format": "uri"},
    "subject": {"type": "string"},
    "time": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "project_id": {"type": "string"},
    "actor": {"type": "object", "properties": {"type": {"type": "string", "enum": ["user", "service"]}, "id": {"type": "string"}}},
    "data": {"type": "object"},
    "datacontenttype": {"type": "string", "enum": ["application/json"]},
    "dataschema": {"type": "string", "format": "uri"}
  },
  "additionalProperties": false
}