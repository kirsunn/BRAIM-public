{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braim.dev/schemas/norm-criterion.json",
  "title": "BRAIM Normative Criterion",
  "description": "Нормативный критерий: требование из источника, привязанное к измеримому свойству (словарь bSDD/BRAIM Pset) и IFC-сущности, с проверкой (порог/вычисление/наличие/скрипт). Артефакт нормативного конвейера (Лингвист → Распознаватель → мета-валидация → human approval).",
  "type": "object",
  "required": [
    "criterion_id",
    "title",
    "modality",
    "statement",
    "applicability",
    "attribute",
    "check",
    "verification",
    "provenance"
  ],
  "properties": {
    "criterion_id": {
      "type": "string",
      "pattern": "^nrm_[0-9a-zA-Z]{16,}$",
      "description": "Глобальный уникальный идентификатор критерия"
    },
    "title": {"type": "string", "description": "Краткое человекочитаемое название"},
    "modality": {
      "type": "string",
      "enum": ["mandatory", "prohibited", "allowed", "recommended"],
      "description": "Модальность нормы: должна / не допускается / допускается / рекомендуется"
    },
    "statement": {"type": "string", "description": "Нормализованная формулировка требования"},
    "quote": {
      "type": "string",
      "maxLength": 400,
      "description": "Дословная цитата из источника (короткая, для верификации; полный текст не хранится — L0-N no_full_copies)"
    },
    "source": {
      "type": "object",
      "properties": {
        "norm_ref": {
          "type": "object",
          "properties": {
            "system": {"type": "string", "description": "SP | GOST | SANPIN | FZ | PNST | LOCAL | MOSCOW_NPA | …"},
            "id": {"type": "string", "description": "Напр. СП 54.13330"},
            "edition": {"type": "string", "description": "Редакция (G-1: применимость по lifecycle-контексту, не по дате прогона)"}
          },
          "required": ["system", "id", "edition"],
          "additionalProperties": false
        },
        "clause": {"type": "string", "description": "Пункт/статья/таблица+строка"},
        "evidence_ref": {"type": "string", "description": "art_… — PDF/скан в приватном контуре (URL+дата+hash в самом артефакте)"},
        "url": {"type": "string", "format": "uri"},
        "verified_at": {"type": "string", "format": "date-time"},
        "verified_by": {"type": "string", "description": "Кто подтвердил по первоисточнику (human)"}
      },
      "additionalProperties": false,
      "description": "Источник требования; заполняется на этапе верификации"
    },
    "verification": {
      "type": "string",
      "enum": ["needs_source", "expert_review", "confirmed", "superseded"],
      "description": "Статус верификации (R-05): confirmed только после проверки по первоисточнику"
    },
    "binding_context": {
      "type": "object",
      "properties": {
        "applicable_from": {"type": "string", "format": "date"},
        "applicable_until": {"type": ["string", "null"], "format": "date"},
        "note": {"type": "string"}
      },
      "additionalProperties": false,
      "description": "G-1: редакционная привязка (переходные периоды)"
    },
    "applicability": {
      "type": "object",
      "required": ["ifc_entities"],
      "properties": {
        "ifc_entities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "description": "IfcSpace, IfcWall, IfcDoor, …"}
        },
        "conditions": {
          "type": "array",
          "description": "Структурные условия применимости (когда критерий действует)",
          "items": {
            "type": "object",
            "required": ["attribute", "op", "value"],
            "properties": {
              "attribute": {"type": "string", "description": "Путь к свойству: Pset_SpaceCommon.IsExternal | classification | layer"},
              "op": {"type": "string", "enum": ["=", "!=", ">", "<", ">=", "<=", "in", "exists"]},
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "text_trigger": {"type": "string", "description": "Слово-триггер из исходного текста (для повторного поиска в источнике)"}
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["attr_id", "unit"],
      "properties": {
        "attr_id": {"type": "string", "description": "Идентификатор в Attribute Registry, напр. tep.height_min"},
        "bsdd_property_ref": {"type": "string", "description": "URI определения свойства в bSDD или локальном bSDD-совместимом словаре (ADR-015)"},
        "ifc_binding": {
          "type": "object",
          "properties": {
            "pset": {"type": "string", "description": "Напр. Pset_SpaceCommon | RusSet_AGR | BRAIM Pset"},
            "property": {"type": "string"}
          },
          "additionalProperties": false,
          "description": "Где свойство живёт на IFC-сущности (маппинг-профиль)"
        },
        "unit": {"type": "string", "description": "m | m2 | h | C | W_m2K | ratio | count | bool"},
        "data_type": {"type": "string", "description": "quantity.* | boolean | enum | string (Attribute Registry)"}
      },
      "additionalProperties": false,
      "description": "Измеримое свойство: соотнесение со словарём и IFC"
    },
    "check": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["threshold", "computed", "presence", "script"],
          "description": "threshold — граница; computed — вычисляемая; presence — наличие; script — детерминированный алгоритм (напр. эвакуационный путь по графу)"
        },
        "threshold": {
          "type": "object",
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "allowed_values": {"type": "array"},
            "tolerance": {"type": "number"},
            "note": {"type": "string", "description": "Зависимость порога от условий (напр. 2.5 м или 2.7 м в зависимости от типа квартиры)"}
          },
          "additionalProperties": false
        },
        "computed": {
          "type": "object",
          "properties": {
            "expression": {"type": "string", "description": "Напр. s_naz + s_podz"},
            "relation": {"type": "string", "enum": ["=", ">=", "<=", ">", "<", "in_tolerance"]},
            "target": {"type": "string", "description": "Напр. s_obsh или число"},
            "tolerance": {"type": "number"},
            "inputs": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "script_ref": {"type": "string", "description": "Для kind=script: идентификатор версии детерминированного скрипта в policy pack"},
        "severity_default": {
          "type": "string",
          "enum": ["critical", "major", "minor", "information"],
          "description": "Дефолт; финальный severity — в манифесте policy pack (гибридная модель правил, Layer Model §3)"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "affects": {"type": "array", "items": {"type": "string"}, "description": "На что влияет (id других критериев/объектов)"},
        "depends_on": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false,
      "description": "Граф зависимостей (проекция Neo4j, не источник истины)"
    },
    "provenance": {
      "type": "object",
      "required": ["linguist", "recognizer"],
      "properties": {
        "linguist": {
          "type": "object",
          "properties": {
            "who": {"type": "string", "description": "human:… | ai:model@version (G-5)"},
            "extracted_at": {"type": "string", "format": "date-time"},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "recognizer": {
          "type": "object",
          "properties": {
            "who": {"type": "string"},
            "rule_expression": {"type": "string"},
            "converted_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "approved_by": {"type": "string", "description": "human:… — без approval критерий не активируется (G-2, G-5)"},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
